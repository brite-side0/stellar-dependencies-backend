HOST=127.0.0.1
PORT=3000
# Optional: server-side token with public repository read access only.
#
# Rate limits: unauthenticated GitHub API requests are rate-limited quickly
# (typically 60 requests/hour per IP). When the limit is hit, the API responds
# with an actionable error that includes the reset time and reminds you to set
# GITHUB_TOKEN. Automatic retries are not performed, so you won't trigger
# retry storms.
#
# Recommended: set GITHUB_TOKEN to raise the rate limit. Use a token with
# public repository read access only (no write scopes).
GITHUB_TOKEN=
# Optional: comma-separated list of exact origins allowed to make cross-origin
# browser requests (e.g. ALLOWED_ORIGINS=http://localhost:5173,https://ui.example.com).
# Origins must match exactly (scheme + host + port). Leave empty to disable all
# cross-origin access. A wildcard ("*") is never used.
ALLOWED_ORIGINS=

# Logging verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Per-request timeout in milliseconds (default: 10000, range: 1-600000)
REQUEST_TIMEOUT_MS=10000

# Maximum response body size in bytes (default: 1048576, range: 1-104857600)
MAX_RESPONSE_BYTES=1048576

# Number of concurrent lookups (default: 6, range: 1-64)
LOOKUP_CONCURRENCY=6

# Comma-separated list of origins allowed to call the API from a browser.
# Use full origins (scheme + host + port), no trailing slash. Use * only for local development.
# Example: https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting (per client IP)
# Window length in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests allowed per window per client IP (default: 30)
RATE_LIMIT_MAX=30
# Trust X-Forwarded-For / proxy headers for client IP detection (default: false)
# Only enable this when running behind a trusted reverse proxy; otherwise
# clients can spoof their IP and bypass rate limiting.
TRUST_PROXY=false

# npm registry cache
# Time-to-live for cached npm metadata in milliseconds (default: 300000)
NPM_CACHE_TTL_MS=300000
# Maximum number of packages kept in the cache (default: 500)
NPM_CACHE_MAX_SIZE=500
# Disable the npm cache entirely (default: false)
NPM_CACHE_DISABLED=false

# Lockfile resolution
# Fetch package-lock.json from the scanned repository to report installed
# versions instead of latest releases (default: true)
FETCH_LOCKFILE=true

# Transitive dependency scanning (opt-in)
# Include transitive dependencies in scans (default: false)
SCAN_TRANSITIVE=false
# Maximum dependency depth to traverse when transitive scanning is enabled
# (default: 3)
SCAN_MAX_DEPTH=3
# Maximum total number of packages to scan when transitive scanning is
# enabled (default: 200)
SCAN_MAX_PACKAGES=200
