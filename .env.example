HOST=127.0.0.1
PORT=3000
# Optional: server-side token with public repository read access only
GITHUB_TOKEN=

# Rate limiting (per client IP)
# Window length in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests allowed per window per client IP (default: 30)
RATE_LIMIT_MAX=30
# Trust X-Forwarded-For / proxy headers for client IP detection (default: false)
# Only enable this when running behind a trusted reverse proxy; otherwise
# clients can spoof their IP and bypass rate limiting.
TRUST_PROXY=false

# npm registry cache
# Time-to-live for cached npm metadata in milliseconds (default: 300000)
NPM_CACHE_TTL_MS=300000
# Maximum number of packages kept in the cache (default: 500)
NPM_CACHE_MAX_SIZE=500
# Disable the npm cache entirely (default: false)
NPM_CACHE_DISABLED=false

# Lockfile resolution
# Fetch package-lock.json from the scanned repository to report installed
# versions instead of latest releases (default: true)
FETCH_LOCKFILE=true

# Transitive dependency scanning (opt-in)
# Include transitive dependencies in scans (default: false)
SCAN_TRANSITIVE=false
# Maximum dependency depth to traverse when transitive scanning is enabled
# (default: 3)
SCAN_MAX_DEPTH=3
# Maximum total number of packages to scan when transitive scanning is
# enabled (default: 200)
SCAN_MAX_PACKAGES=200