HOST=127.0.0.1
PORT=3000
# Optional: server-side token with public repository read access only.
#
# Rate limits: unauthenticated GitHub API requests are rate-limited quickly
# (typically 60 requests/hour per IP). When the limit is hit, the API responds
# with an actionable error that includes the reset time and reminds you to set
# GITHUB_TOKEN. Automatic retries are not performed, so you won't trigger
# retry storms.
#
# Recommended: set GITHUB_TOKEN to raise the rate limit. Use a token with
# public repository read access only (no write scopes).
GITHUB_TOKEN=

# Logging verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Per-request timeout in milliseconds (default: 10000, range: 1-600000)
REQUEST_TIMEOUT_MS=10000

# Maximum response body size in bytes (default: 1048576, range: 1-104857600)
MAX_RESPONSE_BYTES=1048576

# Number of concurrent lookups (default: 6, range: 1-64)
LOOKUP_CONCURRENCY=6

# Comma-separated list of origins allowed to call the API from a browser.
# Use full origins (scheme + host + port), no trailing slash. Use * only for local development.
# Example: https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Whether to trust X-Forwarded-* headers from a reverse proxy (true/false).
# Set to true only when the API runs behind a trusted proxy (nginx, Caddy, a load balancer, etc.).
TRUST_PROXY=false

# Rate limiting: maximum number of requests allowed per client within the window.
RATE_LIMIT_MAX=100

# Rate limiting: window length in milliseconds (default 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000
