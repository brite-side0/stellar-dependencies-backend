HOST=127.0.0.1
PORT=3000
# Optional: server-side token with public repository read access only
GITHUB_TOKEN=
# Optional: comma-separated list of exact origins allowed to make cross-origin
# browser requests (e.g. ALLOWED_ORIGINS=http://localhost:5173,https://ui.example.com).
# Origins must match exactly (scheme + host + port). Leave empty to disable all
# cross-origin access. A wildcard ("*") is never used.
ALLOWED_ORIGINS=

# Comma-separated list of origins allowed to call the API from a browser.
# Use full origins (scheme + host + port), no trailing slash. Use * only for local development.
# Example: https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Whether to trust X-Forwarded-* headers from a reverse proxy (true/false).
# Set to true only when the API runs behind a trusted proxy (nginx, Caddy, a load balancer, etc.).
TRUST_PROXY=false

# Rate limiting: maximum number of requests allowed per client within the window.
RATE_LIMIT_MAX=100

# Rate limiting: window length in milliseconds (default 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000
