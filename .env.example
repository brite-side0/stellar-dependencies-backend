HOST=127.0.0.1
PORT=3000
# Optional: server-side token with public repository read access only
GITHUB_TOKEN=

# Logging verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Per-request timeout in milliseconds (default: 10000, range: 1-600000)
REQUEST_TIMEOUT_MS=10000

# Maximum response body size in bytes (default: 1048576, range: 1-104857600)
MAX_RESPONSE_BYTES=1048576

# Number of concurrent lookups (default: 6, range: 1-64)
LOOKUP_CONCURRENCY=6