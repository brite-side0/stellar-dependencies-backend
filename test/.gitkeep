'use strict';

/**
 * Bounded in-memory TTL cache with LRU eviction.
 *
 * The cache is keyed by package name and stores arbitrary values. Entries
 * expire after `ttlMs` milliseconds. When the number of entries exceeds
 * `maxSize`, the least-recently-used entry is evicted.
 *
 * When `disabled` is true, `get` always misses and `set` is a no-op, which
 * allows tests to bypass the cache entirely.
 */

/**
 * @typedef {Object} NpmCacheOptions
 * @property {number} [ttlMs] Time-to-live for entries in milliseconds.
 * @property {number} [maxSize] Maximum number of entries to retain.
 * @property {boolean} [disabled] When true, the cache is bypassed.
 */

/**
 * @typedef {Object} NpmCache
 * @property {(key: string) => *} get
 * @property {(key: string, value: *) => void} set
 * @property {(key: string) => boolean} has
 * @property {(key: string) => void} delete
 * @property {() => void} clear
 * @property {number} size
 */

const DEFAULT_TTL_MS = 5 * 60 * 1000; // 5 minutes
const DEFAULT_MAX_SIZE = 500;

/**
 * Create a bounded TTL cache.
 *
 * @param {NpmCacheOptions} [options]
 * @returns {NpmCache}
 */
function createNpmCache(options = {}) {
  const {
    ttlMs = DEFAULT_TTL_MS,
    maxSize = DEFAULT_MAX_SIZE,
    disabled = false,
  } = options || {};

  if (typeof ttlMs !== 'number' || Number.isNaN(ttlMs) || ttlMs < 0) {
    throw new TypeError('ttlMs must be a non-negative number');
  }
  if (typeof maxSize !== 'number' || Number.isNaN(maxSize) || maxSize < 0) {
    throw new TypeError('maxSize must be a non-negative number');
  }

  // Map preserves insertion order; we re-insert on access to maintain LRU order.
  /** @type {Map<string, { value: *, expiresAt: number }>} */
  const store = new Map();

  function isExpired(entry) {
    return entry.expiresAt <= Date.now();
  }

  function get(key) {
    if (disabled) {
      return undefined;
    }
    const entry = store.get(key);
    if (entry === undefined) {
      return undefined;
    }
    if (isExpired(entry)) {
      store.delete(key);
      return undefined;
    }
    // Refresh LRU position.
    store.delete(key);
    store.set(key, entry);
    return entry.value;
  }

  function set(key, value) {
    if (disabled) {
      return;
    }
    if (maxSize === 0) {
      return;
    }
    // Remove any existing entry so re-insertion updates LRU order.
    store.delete(key);
    store.set(key, { value, expiresAt: Date.now() + ttlMs });
    // Evict least-recently-used entries until within bounds.
    while (store.size > maxSize) {
      const oldestKey = store.keys().next().value;
      store.delete(oldestKey);
    }
  }

  function has(key) {
    if (disabled) {
      return false;
    }
    const entry = store.get(key);
    if (entry === undefined) {
      return false;
    }
    if (isExpired(entry)) {
      store.delete(key);
      return false;
    }
    return true;
  }

  function del(key) {
    store.delete(key);
  }

  function clear() {
    store.clear();
  }

  return {
    get,
    set,
    has,
    delete: del,
    clear,
    get size() {
      return disabled ? 0 : store.size;
    },
  };
}

module.exports = { createNpmCache, DEFAULT_TTL_MS, DEFAULT_MAX_SIZE };

const { test } = require('node:test');
const assert = require('node:assert');
const path = require('node:path');
const fs = require('node:fs');
const os = require('node:os');

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function makeTempRepo() {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'depscan-test-'));
  return dir;
}

function writeFile(root, rel, content) {
  const full = path.join(root, rel);
  fs.mkdirSync(path.dirname(full), { recursive: true });
  fs.writeFileSync(full, content);
  return full;
}

function cleanup(dir) {
  try {
    fs.rmSync(dir, { recursive: true, force: true });
  } catch (_) {
    // ignore
  }
}

// Attempt to load the module under test. The implementation is expected to
// live at the repository root (e.g. `index.js` / `lib/index.js`). We resolve
// defensively so the tests can be run against the real implementation.
function loadModule() {
  const candidates = [
    path.join(__dirname, '..', 'index.js'),
    path.join(__dirname, '..', 'lib', 'index.js'),
    path.join(__dirname, '..', 'src', 'index.js'),
  ];
  for (const c of candidates) {
    if (fs.existsSync(c)) {
      return require(c);
    }
  }
  return require('..');
}

let mod;
try {
  mod = loadModule();
} catch (err) {
  mod = {};
}

// ---------------------------------------------------------------------------
// #11 Automatic workspace traversal
// ---------------------------------------------------------------------------

test('#11 detects workspaces in root package.json', () => {
  const root = makeTempRepo();
  try {
    writeFile(
      root,
      'package.json',
      JSON.stringify({ name: 'root', workspaces: ['packages/*'] }, null, 2)
    );
    writeFile(
      root,
      'packages/a/package.json',
      JSON.stringify({ name: 'a', dependencies: { left: '^1.0.0' } }, null, 2)
    );

    const detect = mod.detectWorkspaces || mod.findWorkspaces;
    assert.ok(typeof detect === 'function', 'detectWorkspaces should be exported');
    const result = detect(root);
    assert.ok(Array.isArray(result), 'workspace detection should return an array');
    assert.ok(
      result.some((p) => p.replace(/\\/g, '/').endsWith('packages/a/package.json')),
      'should resolve workspace manifest packages/a/package.json'
    );
  } finally {
    cleanup(root);
  }
});

test('#11 resolves globs safely within the repository', () => {
  const root = makeTempRepo();
  try {
    writeFile(
      root,
      'package.json',
      JSON.stringify({ name: 'root', workspaces: ['packages/*'] }, null, 2)
    );
    writeFile(
      root,
      'packages/a/package.json',
      JSON.stringify({ name: 'a', dependencies: {} }, null, 2)
    );

    const detect = mod.detectWorkspaces || mod.findWorkspaces;
    assert.ok(typeof detect === 'function');

    // A glob that escapes the repository must be rejected.
    writeFile(
      root,
      'package.json',
      JSON.stringify({ name: 'root', workspaces: ['../outside/*'] }, null, 2)
    );

    let threw = false;
    let result;
    try {
      result = detect(root);
    } catch (err) {
      threw = true;
      assert.ok(/escape|outside|invalid|traversal/i.test(err.message));
    }
    if (!threw) {
      // If it does not throw, it must not return anything outside the root.
      assert.ok(Array.isArray(result));
      for (const p of result) {
        const rel = path.relative(root, p);
        assert.ok(!rel.startsWith('..'), 'resolved path must stay within repo');
      }
    }
  } finally {
    cleanup(root);
  }
});

test('#11 caps the number of manifests', () => {
  const root = makeTempRepo();
  try {
    const workspaces = [];
    for (let i = 0; i < 50; i++) {
      workspaces.push(`packages/p${i}`);
      writeFile(
        root,
        `packages/p${i}/package.json`,
        JSON.stringify({ name: `p${i}`, dependencies: {} }, null, 2)
      );
    }
    writeFile(
      root,
      'package.json',
      JSON.stringify({ name: 'root', workspaces }, null, 2)
    );

    const detect = mod.detectWorkspaces || mod.findWorkspaces;
    assert.ok(typeof detect === 'function');
    const result = detect(root);
    assert.ok(Array.isArray(result));
    const cap = mod.MAX_WORKSPACE_MANIFESTS || mod.WORKSPACE_MANIFEST_CAP || 20;
    assert.ok(
      result.length <= cap,
      `manifest count ${result.length} should be <= cap ${cap}`
    );
  } finally {
    cleanup(root);
  }
});

test('#11 aggregates and deduplicates dependencies across workspaces', async () => {
  const root = makeTempRepo();
  try {
    writeFile(
      root,
      'package.json',
      JSON.stringify({ name: 'root', workspaces: ['packages/*'] }, null, 2)
    );
    writeFile(
      root,
      'packages/a/package.json',
      JSON.stringify(
        { name: 'a', dependencies: { left: '^1.0.0', shared: '^2.0.0' } },
        null,
        2
      )
    );
    writeFile(
      root,
      'packages/b/package.json',
      JSON.stringify(
        { name: 'b', dependencies: { right: '^3.0.0', shared: '^2.0.0' } },
        null,
        2
      )
    );

    const scan = mod.scan || mod.scanRepo || mod.scanWorkspaces;
    assert.ok(typeof scan === 'function', 'scan should be exported');

    const report = await scan({ root });
    const deps = report.dependencies || report.deps || [];
    const names = deps.map((d) => d.name || d.package);
    assert.ok(names.includes('left'));
    assert.ok(names.includes('right'));
    assert.ok(names.includes('shared'));
    const sharedCount = names.filter((n) => n === 'shared').length;
    assert.strictEqual(sharedCount, 1, 'shared dependency must be deduplicated');
  } finally {
    cleanup(root);
  }
});

// ---------------------------------------------------------------------------
// #12 Allow scanning a specific branch, tag or commit
// ---------------------------------------------------------------------------

test('#12 accepts a valid ref', () => {
  const validate = mod.validateRef || mod.isValidRef;
  assert.ok(typeof validate === 'function', 'validateRef should be exported');
  for (const ref of ['main', 'v1.2.3', 'feature/foo-bar', 'abc1234', 'release_1']) {
    const res = validate(ref);
    assert.ok(res === true || (res && res.valid === true), `ref ${ref} should be valid`);
  }
});

test('#12 rejects invalid refs with a clear error', () => {
  const validate = mod.validateRef || mod.isValidRef;
  assert.ok(typeof validate === 'function');

  const invalid = ['', 'a'.repeat(300), 'bad ref', 'ref~1', 'ref^', 'ref:foo', 'ref\\x'];
  for (const ref of invalid) {
    let threw = false;
    let res;
    try {
      res = validate(ref);
    } catch (err) {
      threw = true;
      assert.ok(err.message && err.message.length > 0);
    }
    if (!threw) {
      assert.ok(
        res === false || (res && res.valid === false),
        `ref ${JSON.stringify(ref)} should be invalid`
      );
    }
  }
});

test('#12 keeps default-branch behavior when ref is omitted', async () => {
  const scan = mod.scan || mod.scanRepo || mod.scanWorkspaces;
  assert.ok(typeof scan === 'function');

  const calls = [];
  const originalFetch = global.fetch;
  global.fetch = async (url, opts) => {
    calls.push({ url: String(url), opts });
    return {
      ok: true,
      status: 200,
      headers: { get: () => null },
      json: async () => ({ name: 'x', dependencies: {} }),
      text: async () => JSON.stringify({ name: 'x', dependencies: {} }),
    };
  };

  try {
    await scan({ repo: 'owner/name' });
    assert.ok(calls.length > 0, 'scan should make a request');
    for (const c of calls) {
      assert.ok(
        !/\/refs\/|\/branches\/|\/commits\//.test(c.url),
        'default scan should not target a specific ref'
      );
    }
  } finally {
    global.fetch = originalFetch;
  }
});

test('#12 targets a specific ref when provided', async () => {
  const scan = mod.scan || mod.scanRepo || mod.scanWorkspaces;
  assert.ok(typeof scan === 'function');

  const calls = [];
  const originalFetch = global.fetch;
  global.fetch = async (url, opts) => {
    calls.push({ url: String(url), opts });
    return {
      ok: true,
      status: 200,
      headers: { get: () => null },
      json: async () => ({ name: 'x', dependencies: {} }),
      text: async () => JSON.stringify({ name: 'x', dependencies: {} }),
    };
  };

  try {
    await scan({ repo: 'owner/name', ref: 'v1.2.3' });
    assert.ok(calls.length > 0);
    const targeted = calls.some((c) => c.url.includes('v1.2.3'));
    assert.ok(targeted, 'scan should target the provided ref');
  } finally {
    global.fetch = originalFetch;
  }
});

// ---------------------------------------------------------------------------
// #13 Structured reason codes for unsupported dependency specs
// ---------------------------------------------------------------------------

test('#13 classifies unsupported specs with reason codes', () => {
  const classify = mod.classifySpec || mod.classifyDependency || mod.reasonCodeFor;
  assert.ok(typeof classify === 'function', 'classifySpec should be exported');

  const cases = [
    { spec: 'npm:foo@^1.0.0', code: 'npm_alias' },
    { spec: 'workspace:*', code: 'workspace_link' },
    { spec: 'workspace:^1.0.0', code: 'workspace_link' },
    { spec: 'file:../local', code: 'local_path' },
    { spec: './local/path', code: 'local_path' },
    { spec: '/abs/path', code: 'local_path' },
    { spec: 'git+https://github.com/x/y.git', code: 'git_dependency' },
    { spec: 'git://github.com/x/y.git', code: 'git_dependency' },
    { spec: 'github:x/y', code: 'git_dependency' },
    { spec: 'user/repo', code: 'git_dependency' },
    { spec: 'something-weird', code: 'unknown' },
  ];

  for (const { spec, code } of cases) {
    const res = classify(spec);
    const got = typeof res === 'string' ? res : res && (res.code || res.reason);
    assert.strictEqual(got, code, `spec ${spec} should classify as ${code}`);
  }
});

test('#13 includes reason codes in report JSON', async () => {
  const root = makeTempRepo();
  try {
    writeFile(
      root,
      'package.json',
      JSON.stringify(
        {
          name: 'root',
          dependencies: {
            alias: 'npm:foo@^1.0.0',
            link: 'workspace:*',
            local: 'file:../local',
            gitdep: 'git+https://github.com/x/y.git',
            weird: 'something-weird',
          },
        },
        null,
        2
      )
    );

    const scan = mod.scan || mod.scanRepo || mod.scanWorkspaces;
    assert.ok(typeof scan === 'function');

    const report = await scan({ root });
    const deps = report.dependencies || report.deps || [];
    const unsupported = deps.filter((d) => d.supported === false || d.unsupported === true);
    assert.ok(unsupported.length >= 5, 'all unsupported deps should be reported');

    const codes = new Set(unsupported.map((d) => d.reason || d.reasonCode || d.code));
    for (const expected of [
      'npm_alias',
      'workspace_link',
      'local_path',
      'git_dependency',
      'unknown',
    ]) {
      assert.ok(codes.has(expected), `report should contain reason code ${expected}`);
    }
  } finally {
    cleanup(root);
  }
});

// ---------------------------------------------------------------------------
// #14 Handle GitHub API rate limits gracefully
// ---------------------------------------------------------------------------

function rateLimitResponse(status, resetEpochSeconds) {
  return {
    ok: false,
    status,
    headers: {
      get(name) {
        const lower = String(name).toLowerCase();
        if (lower === 'x-ratelimit-remaining') return '0';
        if (lower === 'x-ratelimit-reset') return String(resetEpochSeconds);
        if (lower === 'retry-after') return '60';
        return null;
      },
    },
    json: async () => ({ message: 'API rate limit exceeded' }),
    text: async () => 'API rate limit exceeded',
  };
}

for (const status of [403, 429]) {
  test(`#14 handles ${status} rate-limit responses with actionable message`, async () => {
    const scan = mod.scan || mod.scanRepo || mod.scanWorkspaces;
    assert.ok(typeof scan === 'function');

    const reset = Math.floor(Date.now() / 1000) + 3600;
    let callCount = 0;
    const originalFetch = global.fetch;
    global.fetch = async () => {
      callCount++;
      return rateLimitResponse(status, reset);
    };

    try {
      let error;
      try {
        await scan({ repo: 'owner/name' });
      } catch (err) {
        error = err;
      }
      assert.ok(error, 'scan should throw on rate limit');
      assert.ok(/rate limit/i.test(error.message), 'message should mention rate limit');
      assert.ok(/GITHUB_TOKEN/.test(error.message), 'message should mention GITHUB_TOKEN');
      assert.ok(
        error.message.includes(String(reset)) ||
          /reset/i.test(error.message) ||
          /retry/i.test(error.message),
        'message should include reset time'
      );
      assert.strictEqual(callCount, 1, 'should not retry on rate limit');
    } finally {
      global.fetch = originalFetch;
    }
  });
}

test('#14 does not retry on rate limit (no retry storm)', async () => {
  const scan = mod.scan || mod.scanRepo || mod.scanWorkspaces;
  assert.ok(typeof scan === 'function');

  const reset = Math.floor(Date.now() / 1000) + 60;
  let callCount = 0;
  const originalFetch = global.fetch;
  global.fetch = async () => {
    callCount++;
    return rateLimitResponse(403, reset);
  };

  try {
    try {
      await scan({ repo: 'owner/name' });
    } catch (_) {
      // expected
    }
    assert.ok(callCount <= 1, `expected at most 1 fetch call, got ${callCount}`);
  } finally {
    global.fetch = originalFetch;
  }
});
