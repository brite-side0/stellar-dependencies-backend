'use strict';

const { test, before, after } = require('node:test');
const assert = require('node:assert');
const http = require('node:http');

const ALLOWED = 'https://ui.example.com,https://admin.example.com';

let server;
let baseUrl;

function request(path, options = {}) {
  return new Promise((resolve, reject) => {
    const url = new URL(path, baseUrl);
    const req = http.request(
      {
        hostname: url.hostname,
        port: url.port,
        path: url.pathname + url.search,
        method: options.method || 'GET',
        headers: options.headers || {},
      },
      (res) => {
        let body = '';
        res.setEncoding('utf8');
        res.on('data', (chunk) => {
          body += chunk;
        });
        res.on('end', () => {
          resolve({ status: res.statusCode, headers: res.headers, body });
        });
      }
    );
    req.on('error', reject);
    req.end();
  });
}

before(async () => {
  process.env.ALLOWED_ORIGINS = ALLOWED;
  const app = require('../src/app');
  server = http.createServer(app);
  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  const { port } = server.address();
  baseUrl = `http://127.0.0.1:${port}`;
});

after(async () => {
  if (server) {
    await new Promise((resolve) => server.close(resolve));
  }
});

test('allowed origin receives Access-Control-Allow-Origin on simple request', async () => {
  const res = await request('/health', {
    headers: { Origin: 'https://ui.example.com' },
  });
  assert.strictEqual(res.headers['access-control-allow-origin'], 'https://ui.example.com');
});

test('second allowed origin is also permitted', async () => {
  const res = await request('/health', {
    headers: { Origin: 'https://admin.example.com' },
  });
  assert.strictEqual(res.headers['access-control-allow-origin'], 'https://admin.example.com');
});

test('allowed origin preflight returns 204 with CORS headers', async () => {
  const res = await request('/health', {
    method: 'OPTIONS',
    headers: {
      Origin: 'https://ui.example.com',
      'Access-Control-Request-Method': 'GET',
      'Access-Control-Request-Headers': 'content-type',
    },
  });
  assert.strictEqual(res.status, 204);
  assert.strictEqual(res.headers['access-control-allow-origin'], 'https://ui.example.com');
  assert.ok(res.headers['access-control-allow-methods']);
  assert.ok(res.headers['access-control-allow-headers']);
});

test('disallowed origin receives no CORS headers', async () => {
  const res = await request('/health', {
    headers: { Origin: 'https://evil.example.com' },
  });
  assert.strictEqual(res.headers['access-control-allow-origin'], undefined);
  assert.strictEqual(res.headers['access-control-allow-credentials'], undefined);
});

test('disallowed origin preflight receives no CORS headers', async () => {
  const res = await request('/health', {
    method: 'OPTIONS',
    headers: {
      Origin: 'https://evil.example.com',
      'Access-Control-Request-Method': 'GET',
    },
  });
  assert.strictEqual(res.headers['access-control-allow-origin'], undefined);
});

test('request with no Origin receives no CORS headers', async () => {
  const res = await request('/health');
  assert.strictEqual(res.headers['access-control-allow-origin'], undefined);
});

test('wildcard origin is never returned', async () => {
  const origins = ['https://ui.example.com', 'https://evil.example.com', undefined];
  for (const origin of origins) {
    const headers = origin ? { Origin: origin } : {};
    const res = await request('/health', { headers });
    assert.notStrictEqual(res.headers['access-control-allow-origin'], '*');
  }
});
```

```js
'use strict';

const { test, before, after } = require('node:test');
const assert = require('node:assert');
const http = require('node:http');

let server;
let baseUrl;

function request(path, options = {}) {
  return new Promise((resolve, reject) => {
    const url = new URL(path, baseUrl);
    const req = http.request(
      {
        hostname: url.hostname,
        port: url.port,
        path: url.pathname + url.search,
        method: options.method || 'GET',
        headers: options.headers || {},
      },
      (res) => {
        let body = '';
        res.setEncoding('utf8');
        res.on('data', (chunk) => {
          body += chunk;
        });
        res.on('end', () => {
          resolve({ status: res.statusCode, headers: res.headers, body });
        });
      }
    );
    req.on('error', reject);
    req.end();
  });
}

before(async () => {
  const app = require('../src/app');
  server = http.createServer(app);
  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  const { port } = server.address();
  baseUrl = `http://127.0.0.1:${port}`;
});

after(async () => {
  if (server) {
    await new Promise((resolve) => server.close(resolve));
  }
});

test('API responses set X-Content-Type-Options: nosniff', async () => {
  const res = await request('/health');
  assert.strictEqual(res.headers['x-content-type-options'], 'nosniff');
});

test('API responses set a Referrer-Policy', async () => {
  const res = await request('/health');
  assert.ok(res.headers['referrer-policy']);
  assert.strictEqual(res.headers['referrer-policy'], 'no-referrer');
});

test('API responses set Cache-Control: no-store', async () => {
  const res = await request('/health');
  assert.strictEqual(res.headers['cache-control'], 'no-store');
});

test('API responses do not include UI-specific CSP directives', async () => {
  const res = await request('/health');
  const csp = res.headers['content-security-policy'];
  if (csp !== undefined) {
    assert.ok(!/default-src/.test(csp), 'CSP should not contain default-src');
    assert.ok(!/script-src/.test(csp), 'CSP should not contain script-src');
    assert.ok(!/style-src/.test(csp), 'CSP should not contain style-src');
    assert.ok(!/img-src/.test(csp), 'CSP should not contain img-src');
    assert.ok(!/font-src/.test(csp), 'CSP should not contain font-src');
    assert.ok(!/frame-ancestors/.test(csp), 'CSP should not contain frame-ancestors');
  }
});

test('security headers are present on error responses too', async () => {
  const res = await request('/definitely-not-a-route');
  assert.strictEqual(res.headers['x-content-type-options'], 'nosniff');
  assert.strictEqual(res.headers['referrer-policy'], 'no-referrer');
  assert.strictEqual(res.headers['cache-control'], 'no-store');
});