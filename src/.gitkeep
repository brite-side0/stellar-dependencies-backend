'use strict';

const DEFAULT_WINDOW_MS = 60 * 1000;
const DEFAULT_MAX = 30;
const CLEANUP_INTERVAL_MS = 60 * 1000;

/**
 * Parse an integer from an environment variable, falling back to a default.
 * @param {string|undefined} value
 * @param {number} fallback
 * @returns {number}
 */
function parseIntEnv(value, fallback) {
  if (value === undefined || value === null || value === '') {
    return fallback;
  }
  const parsed = Number.parseInt(value, 10);
  if (!Number.isFinite(parsed) || parsed < 0) {
    return fallback;
  }
  return parsed;
}

/**
 * Parse a boolean from an environment variable.
 * @param {string|undefined} value
 * @param {boolean} fallback
 * @returns {boolean}
 */
function parseBoolEnv(value, fallback) {
  if (value === undefined || value === null || value === '') {
    return fallback;
  }
  const normalized = String(value).trim().toLowerCase();
  if (['1', 'true', 'yes', 'on'].includes(normalized)) {
    return true;
  }
  if (['0', 'false', 'no', 'off'].includes(normalized)) {
    return false;
  }
  return fallback;
}

/**
 * Resolve rate limiter configuration from environment variables.
 * @param {NodeJS.ProcessEnv} [env]
 * @returns {{ windowMs: number, max: number, trustProxy: boolean }}
 */
function configFromEnv(env = process.env) {
  return {
    windowMs: parseIntEnv(env.RATE_LIMIT_WINDOW_MS, DEFAULT_WINDOW_MS),
    max: parseIntEnv(env.RATE_LIMIT_MAX, DEFAULT_MAX),
    trustProxy: parseBoolEnv(env.RATE_LIMIT_TRUST_PROXY, false),
  };
}

/**
 * Derive the client IP for a request.
 * @param {object} req
 * @param {boolean} trustProxy
 * @returns {string}
 */
function getClientIp(req, trustProxy) {
  if (trustProxy && req && req.headers) {
    const forwarded = req.headers['x-forwarded-for'];
    if (forwarded) {
      const raw = Array.isArray(forwarded) ? forwarded[0] : forwarded;
      const first = String(raw).split(',')[0].trim();
      if (first) {
        return first;
      }
    }
  }
  if (req && req.socket && req.socket.remoteAddress) {
    return req.socket.remoteAddress;
  }
  if (req && req.connection && req.connection.remoteAddress) {
    return req.connection.remoteAddress;
  }
  return 'unknown';
}

/**
 * Create an in-memory sliding-window rate limiter keyed by client IP.
 *
 * @param {object} [options]
 * @param {number} [options.windowMs] Sliding window length in milliseconds.
 * @param {number} [options.max] Maximum requests allowed per window.
 * @param {boolean} [options.trustProxy] Whether to trust X-Forwarded-For.
 * @returns {{
 *   check: (req: object) => { allowed: boolean, retryAfterSeconds: number },
 *   middleware: (req: object, res: object, next: Function) => void,
 *   reset: () => void,
 *   stop: () => void,
 *   getClientIp: (req: object) => string
 * }}
 */
function createRateLimiter(options = {}) {
  const windowMs = Number.isFinite(options.windowMs) && options.windowMs > 0
    ? options.windowMs
    : DEFAULT_WINDOW_MS;
  const max = Number.isFinite(options.max) && options.max >= 0
    ? options.max
    : DEFAULT_MAX;
  const trustProxy = Boolean(options.trustProxy);

  /** @type {Map<string, number[]>} */
  const hits = new Map();

  function prune(now) {
    const cutoff = now - windowMs;
    for (const [key, timestamps] of hits) {
      const kept = timestamps.filter((ts) => ts > cutoff);
      if (kept.length === 0) {
        hits.delete(key);
      } else if (kept.length !== timestamps.length) {
        hits.set(key, kept);
      }
    }
  }

  function check(req) {
    const now = Date.now();
    const ip = getClientIp(req, trustProxy);
    const cutoff = now - windowMs;

    let timestamps = hits.get(ip);
    if (!timestamps) {
      timestamps = [];
    } else {
      timestamps = timestamps.filter((ts) => ts > cutoff);
    }

    if (timestamps.length >= max) {
      const oldest = timestamps[0];
      const retryAfterMs = Math.max(0, oldest + windowMs - now);
      const retryAfterSeconds = Math.max(1, Math.ceil(retryAfterMs / 1000));
      hits.set(ip, timestamps);
      return { allowed: false, retryAfterSeconds };
    }

    timestamps.push(now);
    hits.set(ip, timestamps);
    return { allowed: true, retryAfterSeconds: 0 };
  }

  function middleware(req, res, next) {
    const result = check(req);
    if (result.allowed) {
      if (typeof next === 'function') {
        next();
      }
      return;
    }
    if (res && typeof res.setHeader === 'function') {
      res.setHeader('Retry-After', String(result.retryAfterSeconds));
    }
    if (res && typeof res.status === 'function' && typeof res.json === 'function') {
      res.status(429).json({
        error: 'Too Many Requests',
        retryAfterSeconds: result.retryAfterSeconds,
      });
      return;
    }
    if (res && typeof res.writeHead === 'function') {
      res.writeHead(429, { 'Retry-After': String(result.retryAfterSeconds) });
      if (typeof res.end === 'function') {
        res.end('Too Many Requests');
      }
    }
  }

  function reset() {
    hits.clear();
  }

  const cleanupTimer = setInterval(() => prune(Date.now()), CLEANUP_INTERVAL_MS);
  if (typeof cleanupTimer.unref === 'function') {
    cleanupTimer.unref();
  }

  function stop() {
    clearInterval(cleanupTimer);
  }

  return {
    check,
    middleware,
    reset,
    stop,
    getClientIp: (req) => getClientIp(req, trustProxy),
  };
}

module.exports = {
  createRateLimiter,
  configFromEnv,
  getClientIp,
  parseIntEnv,
  parseBoolEnv,
  DEFAULT_WINDOW_MS,
  DEFAULT_MAX,
};